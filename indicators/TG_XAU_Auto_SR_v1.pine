//@version=6
indicator("TG XAU 自動支撐壓力 v1", shorttitle = "TG XAU S/R", overlay = true, max_lines_count = 50, max_labels_count = 50)

string GROUP_CORE = "核心"
string GROUP_DISPLAY = "顯示"
int pivotLeft = input.int(3, "Pivot 左側確認 K 數", minval = 1, group = GROUP_CORE)
int pivotRight = input.int(3, "Pivot 右側確認 K 數", minval = 1, group = GROUP_CORE)
int atrLength = input.int(14, "ATR 週期", minval = 1, group = GROUP_CORE)
float clusterAtrMult = input.float(0.20, "同區域聚類 ATR 倍數", minval = 0.01, step = 0.01, group = GROUP_CORE)
int maxStoredLevels = input.int(30, "內部最多保留層級", minval = 6, maxval = 100, group = GROUP_CORE)
int maxDisplayed = input.int(3, "上下各顯示幾條", minval = 1, maxval = 5, group = GROUP_DISPLAY)
bool showLabels = input.bool(true, "顯示 S/R 標籤", group = GROUP_DISPLAY)
bool showTouches = input.bool(true, "標籤顯示聚類次數", group = GROUP_DISPLAY)

float atrValue = ta.atr(atrLength)
float pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
float pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
var array<float> resistanceLevels = array.new_float()
var array<int> resistanceTouches = array.new_int()
var array<float> supportLevels = array.new_float()
var array<int> supportTouches = array.new_int()

if barstate.isconfirmed and not na(pivotHigh)
    float tol = nz(atrValue[pivotRight], syminfo.mintick) * clusterAtrMult
    int found = -1
    float bestDistance = 1e20
    int n = array.size(resistanceLevels)
    if n > 0
        for i = 0 to n - 1
            float d = math.abs(array.get(resistanceLevels, i) - pivotHigh)
            if d <= tol and d < bestDistance
                bestDistance := d
                found := i
    if found >= 0
        int touches = array.get(resistanceTouches, found)
        float oldLevel = array.get(resistanceLevels, found)
        array.set(resistanceLevels, found, (oldLevel * touches + pivotHigh) / (touches + 1))
        array.set(resistanceTouches, found, touches + 1)
    else
        array.push(resistanceLevels, pivotHigh)
        array.push(resistanceTouches, 1)
        if array.size(resistanceLevels) > maxStoredLevels
            array.shift(resistanceLevels)
            array.shift(resistanceTouches)

if barstate.isconfirmed and not na(pivotLow)
    float tol = nz(atrValue[pivotRight], syminfo.mintick) * clusterAtrMult
    int found = -1
    float bestDistance = 1e20
    int n = array.size(supportLevels)
    if n > 0
        for i = 0 to n - 1
            float d = math.abs(array.get(supportLevels, i) - pivotLow)
            if d <= tol and d < bestDistance
                bestDistance := d
                found := i
    if found >= 0
        int touches = array.get(supportTouches, found)
        float oldLevel = array.get(supportLevels, found)
        array.set(supportLevels, found, (oldLevel * touches + pivotLow) / (touches + 1))
        array.set(supportTouches, found, touches + 1)
    else
        array.push(supportLevels, pivotLow)
        array.push(supportTouches, 1)
        if array.size(supportLevels) > maxStoredLevels
            array.shift(supportLevels)
            array.shift(supportTouches)

var array<line> resistanceLines = array.new_line(5)
var array<label> resistanceLabels = array.new_label(5)
var array<line> supportLines = array.new_line(5)
var array<label> supportLabels = array.new_label(5)
float confirmedPrice = barstate.isconfirmed ? close : close[1]

if barstate.islast and not na(confirmedPrice)
    array<bool> usedR = array.new_bool(array.size(resistanceLevels), false)
    array<bool> usedS = array.new_bool(array.size(supportLevels), false)
    for slot = 0 to 4
        line oldRLine = array.get(resistanceLines, slot)
        label oldRLabel = array.get(resistanceLabels, slot)
        line oldSLine = array.get(supportLines, slot)
        label oldSLabel = array.get(supportLabels, slot)
        if slot < maxDisplayed
            int bestR = -1
            float bestRDistance = 1e20
            int rn = array.size(resistanceLevels)
            if rn > 0
                for i = 0 to rn - 1
                    float level = array.get(resistanceLevels, i)
                    float d = level - confirmedPrice
                    if not array.get(usedR, i) and d > 0 and d < bestRDistance
                        bestRDistance := d
                        bestR := i
            if bestR >= 0
                array.set(usedR, bestR, true)
                float level = array.get(resistanceLevels, bestR)
                int touches = array.get(resistanceTouches, bestR)
                if na(oldRLine)
                    oldRLine := line.new(bar_index, level, bar_index + 1, level, extend = extend.both, color = color.new(color.red, 15), width = 1)
                    array.set(resistanceLines, slot, oldRLine)
                else
                    line.set_xy1(oldRLine, bar_index, level)
                    line.set_xy2(oldRLine, bar_index + 1, level)
                if showLabels
                    string txt = "R" + str.tostring(slot + 1) + "  " + str.tostring(level, format.mintick) + (showTouches ? "｜聚類 " + str.tostring(touches) : "")
                    if na(oldRLabel)
                        oldRLabel := label.new(bar_index, level, txt, style = label.style_label_left, textcolor = color.white, color = color.new(color.red, 60), size = size.tiny)
                        array.set(resistanceLabels, slot, oldRLabel)
                    else
                        label.set_xy(oldRLabel, bar_index, level)
                        label.set_text(oldRLabel, txt)
                else if not na(oldRLabel)
                    label.delete(oldRLabel)
                    array.set(resistanceLabels, slot, na)
            else
                if not na(oldRLine)
                    line.delete(oldRLine)
                    array.set(resistanceLines, slot, na)
                if not na(oldRLabel)
                    label.delete(oldRLabel)
                    array.set(resistanceLabels, slot, na)

            int bestS = -1
            float bestSDistance = 1e20
            int sn = array.size(supportLevels)
            if sn > 0
                for i = 0 to sn - 1
                    float level = array.get(supportLevels, i)
                    float d = confirmedPrice - level
                    if not array.get(usedS, i) and d > 0 and d < bestSDistance
                        bestSDistance := d
                        bestS := i
            if bestS >= 0
                array.set(usedS, bestS, true)
                float level = array.get(supportLevels, bestS)
                int touches = array.get(supportTouches, bestS)
                if na(oldSLine)
                    oldSLine := line.new(bar_index, level, bar_index + 1, level, extend = extend.both, color = color.new(color.lime, 20), width = 1)
                    array.set(supportLines, slot, oldSLine)
                else
                    line.set_xy1(oldSLine, bar_index, level)
                    line.set_xy2(oldSLine, bar_index + 1, level)
                if showLabels
                    string txt = "S" + str.tostring(slot + 1) + "  " + str.tostring(level, format.mintick) + (showTouches ? "｜聚類 " + str.tostring(touches) : "")
                    if na(oldSLabel)
                        oldSLabel := label.new(bar_index, level, txt, style = label.style_label_left, textcolor = color.white, color = color.new(color.green, 60), size = size.tiny)
                        array.set(supportLabels, slot, oldSLabel)
                    else
                        label.set_xy(oldSLabel, bar_index, level)
                        label.set_text(oldSLabel, txt)
                else if not na(oldSLabel)
                    label.delete(oldSLabel)
                    array.set(supportLabels, slot, na)
            else
                if not na(oldSLine)
                    line.delete(oldSLine)
                    array.set(supportLines, slot, na)
                if not na(oldSLabel)
                    label.delete(oldSLabel)
                    array.set(supportLabels, slot, na)
        else
            if not na(oldRLine)
                line.delete(oldRLine)
                array.set(resistanceLines, slot, na)
            if not na(oldRLabel)
                label.delete(oldRLabel)
                array.set(resistanceLabels, slot, na)
            if not na(oldSLine)
                line.delete(oldSLine)
                array.set(supportLines, slot, na)
            if not na(oldSLabel)
                label.delete(oldSLabel)
                array.set(supportLabels, slot, na)